# The Oracle VM's settings: copy to .env (cp .env.example .env) and fill them in. .env is never committed.

# The site's address, without https://: your DuckDNS name, or a domain of your own, pointing to the VM's public IP.
SITE_ADDRESS=sla-yourname.duckdns.org

# The database Render uses: Aiven's Service URI. If the password has an @ in it, write it as %40; if it has a $,
# put the whole value in single quotes.
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_SERVICE.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
